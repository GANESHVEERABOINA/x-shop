pipeline {
    agent any

    stages {
        stage('Clone git repo') {
            steps {
                git branch: 'main', url: 'https://github.com/GANESHVEERABOINA/x-shop.git'
            }
        }

        stage('Build') {
            steps {
                dir('frontend') {
                    sh 'docker image build -t frontend --no-cache -f Dockerfile .'
                    sh 'docker images'
                }
            }
        }

        stage('Deploy in docker container') {
            steps {
                sh 'docker rm -f frontend || true'
                sh 'docker container run -d -p 8081:80  --name frontend frontend:latest'
                sh 'docker container ps -a'
            }
        }
    }
}